# Docker Compose environment variables
#
# Copy to `.env` and fill in real values. `.env` is gitignored.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# --- Required security secrets ---
# Each MUST be a unique ≥64-char random value. Do not reuse across variables.
JWT_SECRET=replace_with_a_unique_64_char_secret
REFRESH_TOKEN_SECRET=replace_with_a_different_unique_64_char_secret
CSRF_SECRET=replace_with_a_third_unique_64_char_secret

# --- MongoDB credentials ---
# These are consumed both by the mongo container (to initialise the root user)
# and by the backend (to build its connection string). They must match.
MONGO_INITDB_ROOT_USERNAME=numisroma
MONGO_INITDB_ROOT_PASSWORD=replace_with_a_long_random_password

# --- Environment ---
NODE_ENV=production

# --- Domain (docker-compose.prod.yml) ---
# Your domain without protocol, e.g. numisroma.com
# Frontend will be served at https://$DOMAIN
# Backend will be served at https://api.$DOMAIN
DOMAIN=numisroma.example.com

# --- Frontend API URL (used by docker-compose.yml for local dev only) ---
# In production this is derived automatically from DOMAIN above.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Frontend origins (comma-separated for multiple) ---
FRONTEND_URL=http://localhost:3000

# --- Ko-fi donations ---
NEXT_PUBLIC_KOFI_URL=https://ko-fi.com/numisroma
NEXT_PUBLIC_KOFI_USERNAME=numisroma

# --- Backend port ---
PORT=4000

# --- MongoDB backup destination (docker-compose.prod.yml) ---
BACKUP_DIR=./backups

# --- Redis (optional — falls back to in-memory when unset) ---
# REDIS_URL=redis://localhost:6379

# --- Image storage: Cloudflare R2 or AWS S3 (optional — falls back to local disk) ---
# AWS_S3_BUCKET=numisroma-uploads
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_CUSTOM_DOMAIN=pub-xxxx.r2.dev
# AWS_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com  # R2 only, omit for real AWS S3

BACKEND_URL=http://localhost:4000

# --- Google OAuth (optional — enables "Sign in with Google") ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret

# --- Resend email service (required for registration, password reset) ---
# Get your API key from https://resend.com/api-keys
# The sender address must be verified in your Resend domain settings.
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=NumisRoma <noreply@yourdomain.com>
SUPPORT_EMAIL=support@numisroma.com

# --- Abstract API — email mailbox verification (optional) ---
# Free tier: 100 verifications/day. Skipped when unset (fail-open).
# https://www.abstractapi.com/email-verification-validation-api
# ABSTRACT_EMAIL_API_KEY=your_abstract_api_key_here

# --- Google Vision API (optional — AI image validation) ---
# Enables coin-presence detection on coin uploads and NSFW + incoherent-content
# rejection on collection thumbnails. Skipped when unset (quality checks still run).
# Free tier: 1,000 units/month. Setup: https://cloud.google.com/vision/docs/setup
# GOOGLE_VISION_API_KEY=your_api_key_here

# --- Admin API key (optional — required to access /api/cache endpoints) ---
# Min 32 chars. Generate with the same command above.
# ADMIN_API_KEY=replace_with_a_32_char_secret

# --- Sentry error tracking (optional) ---
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# --- Prometheus metrics protection (optional) ---
# METRICS_API_KEY=replace_with_a_random_secret
