# Database Configuration
MONGODB_URI=your_mongodb_uri

# JWT Configuration
# CRITICAL: Generate secure random secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER reuse secrets across JWT/refresh/CSRF
JWT_SECRET=your_jwt_secret_change_this_in_production
REFRESH_TOKEN_SECRET=your_refresh_token_secret_must_be_different_and_changed_in_production
CSRF_SECRET=your_csrf_secret_change_this_in_production_and_keep_unique
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
ROTATE_REFRESH_TOKENS=true
MAX_REFRESH_TOKENS_PER_USER=5
TOKEN_ISSUER=numisroma-api
TOKEN_AUDIENCE=numisroma-client

# Server Configuration
PORT=4000
NODE_ENV=development

# Frontend Configuration (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000

# Logging Configuration (optional)
LOG_LEVEL=info
LOG_QUERIES=false

# Redis Configuration (optional, for caching)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379

# Cache Configuration (optional, in seconds)
# CACHE_DEFAULT_TTL=300
# CACHE_COINS_TTL=600
# CACHE_COLLECTIONS_TTL=300
# CACHE_USERS_TTL=900
# CACHE_SEARCH_TTL=180
# CACHE_FILTERS_TTL=1800
# Sentry error tracking (optional — leave blank to disable)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus metrics endpoint protection (optional)
# If set, requests to /metrics from non-localhost must supply this key
# in the X-Metrics-Api-Key header.
# METRICS_API_KEY=change-me-to-a-random-secret

# Google OAuth — https://console.cloud.google.com/
# BACKEND_URL is the public URL of this API server (used as OAuth callback base)
# BACKEND_URL=http://localhost:4000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Abstract API — email mailbox verification (https://www.abstractapi.com/email-verification-validation-api)
# Free tier: 100 verifications/day. Without this key, mailbox verification is skipped (fail-open).
# ABSTRACT_EMAIL_API_KEY=your_abstract_api_key_here

# Resend email service — https://resend.com
# Required for the email-verified registration flow (OTP + welcome email).
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# The verified sender address configured in your Resend domain settings.
# Format: "Display Name <address@yourdomain.com>"
RESEND_FROM_EMAIL=NumisRoma <noreply@numisroma.com>

# S3-compatible image storage (optional — falls back to local disk + MongoDB when unset)
# User-uploaded images (collection thumbnails, coin custom images) are stored here.
# The bucket must be PRIVATE — images are always served via the backend proxy routes,
# never via direct public URLs, so that auth checks are enforced.
#
# For Cloudflare R2:
# AWS_S3_BUCKET=numisroma
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=<R2 access key id>
# AWS_SECRET_ACCESS_KEY=<R2 secret access key>
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#
# For AWS S3:
# AWS_S3_BUCKET=numisroma-uploads
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
